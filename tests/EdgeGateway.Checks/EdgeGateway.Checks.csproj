<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Own configuration, so the checks build while the gateway runs (its bin\Debug exe is locked). -->
    <ProjectReference Include="..\..\EdgeGateway.csproj" SetConfiguration="Configuration=Checks" />
  </ItemGroup>

</Project>
