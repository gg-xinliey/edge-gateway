const state = {
  file: 'point-map',
  fileName: 'point-map.json',
  label: 'Point Map',
  data: null,
  dirty: false,
  rawMode: false,
  search: ''
};

const $ = id => document.getElementById(id);

function toast(message) {
  const el = $('toast');
  el.textContent = message;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2200);
}

async function request(url, options) {
  const res = await fetch(url, options);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
  return data;
}

async function health() {
  try { await request('/api/health'); $('status').textContent = 'Server connected'; }
  catch { $('status').textContent = 'Server unavailable'; }
}

async function loadFile(key) {
  const titles = { 'point-map': ['point-map.json','Point Map'], 'timestamp-rules': ['timestamp-rules.json','Timestamp Rules'] };
  state.file = key;
  [state.fileName, state.label] = titles[key];
  const data = await request(`/api/config/${key}`);
  state.data = data;
  state.dirty = false;
  $('fileName').textContent = state.fileName;
  $('editorTitle').textContent = state.label;
  $('rawEditor').value = JSON.stringify(state.data, null, 2);
  updateStatus();
  render();
}

function updateStatus() {
  $('dirtyState').textContent = state.dirty ? 'Unsaved changes' : 'Saved';
  $('dirtyState').style.color = state.dirty ? '#b45309' : '';
}

function markDirty() { state.dirty = true; updateStatus(); }

function primitiveInput(value, onChange) {
  const input = document.createElement('input');
  input.value = value === null ? '' : String(value);
  input.addEventListener('input', () => { onChange(input.value); markDirty(); });
  return input;
}

function setPrimitive(target, key, text) {
  const old = target[key];
  if (typeof old === 'number') {
    const n = Number(text);
    if (!Number.isNaN(n)) target[key] = n;
  } else if (typeof old === 'boolean') {
    target[key] = text.toLowerCase() === 'true';
  } else if (old === null) {
    target[key] = text === '' ? null : text;
  } else {
    target[key] = text;
  }
}

function renderObject(obj, pathLabel) {
  const group = document.createElement('div');
  group.className = 'group';
  const head = document.createElement('div'); head.className = 'group-head';
  const title = document.createElement('div'); title.className = 'group-title'; title.textContent = pathLabel;
  head.appendChild(title); group.appendChild(head);
  const fields = document.createElement('div'); fields.className = 'fields';

  Object.entries(obj).forEach(([key, value]) => {
    if (state.search && !JSON.stringify({key,value}).toLowerCase().includes(state.search.toLowerCase())) return;
    const row = document.createElement('div'); row.className='field';
    const label = document.createElement('label'); label.textContent = key; row.appendChild(label);
    if (value !== null && typeof value === 'object') {
      const text = document.createElement('textarea'); text.rows = 4; text.value = JSON.stringify(value,null,2);
      text.addEventListener('change', () => { try { obj[key] = JSON.parse(text.value); markDirty(); render(); } catch(e) { alert('Invalid JSON for ' + key + ': ' + e.message); } });
      row.appendChild(text);
    } else {
      row.appendChild(primitiveInput(value, text => setPrimitive(obj, key, text)));
    }
    fields.appendChild(row);
  });

  group.appendChild(fields);
  return group;
}

function render() {
  const root = $('formEditor'); root.innerHTML = '';
  if (state.rawMode) return;
  const data = state.data;
  if (Array.isArray(data)) {
    $('itemCount').textContent = data.length;
    data.forEach((item, i) => {
      if (item && typeof item === 'object' && !Array.isArray(item)) root.appendChild(renderObject(item, `Item ${i + 1}`));
      else root.appendChild(renderObject({ value: item }, `Item ${i + 1}`));
    });
  } else if (data && typeof data === 'object') {
    const entries = Object.entries(data);
    $('itemCount').textContent = entries.length;
    entries.forEach(([key, value]) => {
      if (value && typeof value === 'object' && !Array.isArray(value)) root.appendChild(renderObject(value, key));
      else root.appendChild(renderObject({ [key]: value }, key));
    });
  } else {
    $('itemCount').textContent = '1';
    root.appendChild(renderObject({ value: data }, 'Value'));
  }
  if (!root.children.length) root.innerHTML = '<div class="empty">No matching fields.</div>';
}

function syncRawToState() {
  try { state.data = JSON.parse($('rawEditor').value); return true; }
  catch (e) { alert('Invalid JSON: ' + e.message); return false; }
}

$('prettyBtn').addEventListener('click', () => {
  if (state.rawMode) {
    if (!syncRawToState()) return;
  }
  $('rawEditor').value = JSON.stringify(state.data, null, 2);
  toast('JSON formatted');
});

$('rawBtn').addEventListener('click', () => {
  state.rawMode = !state.rawMode;
  $('rawEditor').classList.toggle('hidden', !state.rawMode);
  $('formEditor').classList.toggle('hidden', state.rawMode);
  if (state.rawMode) $('rawEditor').value = JSON.stringify(state.data, null, 2);
  else if (syncRawToState()) render();
});

$('search').addEventListener('input', e => { state.search = e.target.value; render(); });

$('saveBtn').addEventListener('click', async () => {
  if (state.rawMode && !syncRawToState()) return;
  try {
    await request(`/api/config/${state.file}`, {
      method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify(state.data)
    });
    state.dirty = false; updateStatus(); render(); toast(`${state.fileName} saved and runtime reloaded`);
  } catch (e) { toast(e.message); }
});

$('reloadBtn').addEventListener('click', async () => {
  try { await request('/api/config/reload',{method:'POST'}); await loadFile(state.file); toast('Runtime configuration reloaded'); }
  catch(e){ toast(e.message); }
});

$('addBtn').addEventListener('click', () => {
  if (!Array.isArray(state.data)) { toast('Add is available for list-style configuration files'); return; }
  state.data.push({}); markDirty(); render();
});

document.querySelectorAll('.file-tab').forEach(btn => btn.addEventListener('click', async () => {
  if (state.dirty && !confirm('You have unsaved changes. Switch files without saving?')) return;
  document.querySelectorAll('.file-tab').forEach(x => x.classList.remove('active'));
  btn.classList.add('active');
  await loadFile(btn.dataset.file);
}));

health();
loadFile('point-map').catch(e => { $('formEditor').innerHTML = `<div class="empty">${e.message}</div>`; $('status').textContent = 'Config load failed'; });
