<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>EdgeGateway — Configuration</title>
  <link rel="stylesheet" href="/config/app.css" />
</head>
<body>
  <header class="topbar">
    <div>
      <div class="eyebrow">EDGEGATEWAY</div>
      <h1>User Configuration</h1>
      <p>Manage the existing point map and timestamp rules used by the server.</p>
    </div>
    <div class="status" id="status">Checking server…</div>
  </header>

  <main class="shell">
    <aside class="sidebar card">
      <div class="section-title">CONFIG FILES</div>
      <button class="file-tab active" data-file="point-map">Point Map<span>point-map.json</span></button>
      <button class="file-tab" data-file="timestamp-rules">Timestamp Rules<span>timestamp-rules.json</span></button>
      <div class="sidebar-foot">
        <button id="reloadBtn" class="ghost">Reload runtime</button>
      </div>
    </aside>

    <section class="workspace">
      <div class="toolbar card">
        <div class="toolbar-left">
          <label class="search">
            <span>⌕</span>
            <input id="search" placeholder="Search fields…" />
          </label>
          <button id="prettyBtn" class="ghost">Format JSON</button>
          <button id="rawBtn" class="ghost">Raw JSON</button>
        </div>
        <div class="toolbar-right">
          <button id="saveBtn" class="primary">Save changes</button>
        </div>
      </div>

      <div class="info-row">
        <div class="card stat"><span class="label">FILE</span><strong id="fileName">point-map.json</strong></div>
        <div class="card stat"><span class="label">ITEMS</span><strong id="itemCount">—</strong></div>
        <div class="card stat"><span class="label">STATE</span><strong id="dirtyState">Saved</strong></div>
      </div>

      <section id="editorCard" class="card editor-card">
        <div class="editor-head">
          <div>
            <div class="section-title">EDITOR</div>
            <h2 id="editorTitle">Point Map</h2>
          </div>
          <button id="addBtn" class="ghost">+ Add</button>
        </div>
        <div id="formEditor" class="form-editor"></div>
        <textarea id="rawEditor" class="raw-editor hidden" spellcheck="false"></textarea>
      </section>
    </section>
  </main>

  <div id="toast" class="toast"></div>
  <script src="/config/app.js"></script>
</body>
</html>
